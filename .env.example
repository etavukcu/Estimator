# Required for production email delivery to info@peacefulhavenhomes.com
# Create a free API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Required in production: a sender Resend has verified for your domain.
# Example after verifying peacefulhavenhomes.com:
EMAIL_FROM="Peaceful Haven Homes <noreply@peacefulhavenhomes.com>"

# Optional: override the inbox that receives leads (default is info@peacefulhavenhomes.com).
# Useful for a first smoke test to your own address.
# LEAD_NOTIFY_TO=you@example.com

# Optional: log the email instead of calling Resend. Safe local/dev test mode.
# LEAD_EMAIL_DRY_RUN=true

# Required for the built-in /api/consultation-requests server endpoint
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: if service role isn't available for this environment
SUPABASE_ANON_KEY=your-anon-key

# Optional: route submissions through a custom API server (instead of same-origin /api)
VITE_API_BASE_URL=http://localhost:8787

# Optional override for direct client-side Supabase submission
# (the app already includes a default project fallback)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
